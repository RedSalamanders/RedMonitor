<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <MonitorProject Include="src/RedMonitor.vcxproj" />
    <MonitorProject Include="Tests/MonitorTests/MonitorTests.vcxproj" Condition="'$(RedMonitorProductionOnly)'!='true'" />
    <MonitorProject Include="Tests/ClientContractTests/ClientContractTests.vcxproj" Condition="'$(RedMonitorProductionOnly)'!='true'" />
    <MonitorProject Include="Tests/TransportRoundtripTests/TransportRoundtripTests.vcxproj" Condition="'$(RedMonitorProductionOnly)'!='true'" />
    <MonitorProject Include="src/Lang/fr-FR/RedMonitor-fr-FR.vcxproj" />
    <MonitorProject Include="src/Lang/ja-JP/RedMonitor-ja-JP.vcxproj" />
    <MonitorProject Include="src/Lang/cs-CZ/RedMonitor-cs-CZ.vcxproj" />
    <MonitorProject Include="src/Lang/sk-SK/RedMonitor-sk-SK.vcxproj" />
    <MonitorProject Include="Tests/AsanProbeTests/AsanProbeTests.vcxproj" Condition="('$(Configuration)'=='ASan Debug') and '$(RedMonitorProductionOnly)'!='true'" />
    <MonitorProject Include="Tests/SettingsContractTests/SettingsContractTests.vcxproj" Condition="'$(RedMonitorProductionOnly)'!='true'" />
  </ItemGroup>
  <Target Name="Clean">
    <MSBuild Projects="@(MonitorProject);support/RedMonitorSupport.vcxproj" Targets="Clean"
             Properties="Platform=$(Platform);Configuration=$(Configuration);BuildProjectReferences=false" BuildInParallel="false" />
  </Target>
  <Target Name="PrepareAnalysis" BeforeTargets="Build" DependsOnTargets="Clean" Condition="'$(RedMonitorAnalyze)'=='true'" />
  <Target Name="Build">
    <MSBuild Projects="@(MonitorProject)" Properties="Platform=$(Platform);Configuration=$(Configuration)" BuildInParallel="false" />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
</Project>
