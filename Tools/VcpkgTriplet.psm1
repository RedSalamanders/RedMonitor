Set-StrictMode -Version Latest
$root = Split-Path -Parent $PSScriptRoot
Import-Module (Join-Path $root '.ci-engine/Tools/Modules/Ci.EngineBinding.psm1') -ErrorAction Stop
Import-Module (Resolve-CiPinnedEngineModule -ProjectRoot $root -Name 'VcpkgTriplet.psm1') -Scope Local -ErrorAction Stop

$header = '# RedMonitor: build with the Visual Studio installation and default MSVC toolset MSBuild uses (generated by vcpkg-install.ps1; do not edit).'

function Get-RedMonitorVcpkgOverlayTripletText {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string] $StockText,
        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string] $Installation,
        [Parameter(Mandatory)][ValidatePattern('^[0-9]+\.[0-9]+$')][string] $ToolsetVersion
    )

    Get-CiVcpkgOverlayTripletText -SourceText $StockText -Installation $Installation -ToolsetVersion $ToolsetVersion -Header $header
}

function Update-RedMonitorVcpkgOverlayTriplet {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string] $StockTripletPath,
        [Parameter(Mandatory)] $Toolset,
        [Parameter(Mandatory)][string] $OutputDirectory
    )

    Update-CiVcpkgOverlayTriplet -ProjectRoot $root -SourceTripletPath $StockTripletPath -Toolset $Toolset -OutputDirectory $OutputDirectory -Header $header |
        Select-Object Triplet, Directory, Path, Changed
}

Export-ModuleMember -Function Get-RedMonitorVcpkgOverlayTripletText, Update-RedMonitorVcpkgOverlayTriplet
