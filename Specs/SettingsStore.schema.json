{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:redmonitor:settings-store:16",
  "title": "RedMonitor Settings Store",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 16
    },
    "windows": {
      "type": "object",
      "title": "Viewer window placement",
      "properties": {
        "MonitorWindow": {
          "$ref": "#/$defs/windowPlacement"
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "$ref": "#/$defs/themeSettings"
    },
    "monitor": {
      "$ref": "#/$defs/monitorSettings"
    },
    "ui": {
      "$ref": "#/$defs/uiSettings"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "windowPlacement": {
      "type": "object",
      "title": "Window Placement",
      "description": "Saved window placement (state, bounds, DPI, and optional monitor identity).",
      "required": [
        "state",
        "bounds"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "normal",
            "maximized"
          ],
          "title": "State",
          "description": "Normal or maximized."
        },
        "bounds": {
          "$ref": "#/$defs/windowBounds",
          "title": "Bounds",
          "description": "Saved bounds for the window."
        },
        "dpi": {
          "type": "integer",
          "minimum": 1,
          "title": "DPI",
          "description": "DPI used when saving bounds."
        },
        "monitorDeviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "title": "Monitor Device",
          "description": "Display device identity used to prefer the saved monitor when it is still connected."
        }
      },
      "additionalProperties": false
    },
    "themeSettings": {
      "type": "object",
      "title": "Theme",
      "description": "Theme selection and user theme definitions.",
      "x-ui-pane": "Themes",
      "x-ui-control": "custom",
      "x-ui-order": 0,
      "properties": {
        "currentThemeId": {
          "$ref": "#/$defs/themeId",
          "default": "builtin/system",
          "title": "Current Theme",
          "description": "Id of the active theme."
        },
        "themes": {
          "type": "array",
          "default": [],
          "title": "Themes",
          "description": "User theme definitions stored in settings.",
          "items": {
            "$ref": "#/$defs/themeDefinition"
          }
        }
      },
      "additionalProperties": false
    },
    "monitorSettings": {
      "type": "object",
      "title": "Monitor",
      "description": "Preferences for the Monitor window.",
      "x-ui-pane": "Advanced",
      "x-ui-control": "custom",
      "x-ui-order": 0,
      "properties": {
        "menu": {
          "$ref": "#/$defs/monitorMenuState",
          "title": "Menu",
          "description": "Monitor menu and toolbar settings."
        },
        "filter": {
          "$ref": "#/$defs/monitorFilterSettings",
          "title": "Filter",
          "description": "Monitor message filter settings."
        }
      },
      "additionalProperties": false
    },
    "uiSettings": {
      "type": "object",
      "default": {},
      "title": "UI",
      "description": "App-wide DxUI behavior and chrome preferences.",
      "properties": {
        "language": {
          "type": "string",
          "default": "system",
          "title": "Language",
          "description": "Application language. Use system to follow the Windows display language.",
          "anyOf": [
            {
              "const": "system"
            },
            {
              "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
            }
          ],
          "x-ui-pane": "General",
          "x-ui-order": 5,
          "x-ui-control": "custom",
          "x-ui-section": "Display"
        },
        "compactMode": {
          "type": "boolean",
          "default": true,
          "title": "Compact mode",
          "description": "Use compact spacing and control density on supported DxUI surfaces.",
          "x-ui-pane": "General",
          "x-ui-order": 40,
          "x-ui-control": "toggle",
          "x-ui-section": "DxUI"
        },
        "reducedMotion": {
          "$ref": "#/$defs/reducedMotionMode",
          "description": "Choose whether DxUI motion follows the OS setting, stays reduced, or stays fully animated.",
          "x-ui-pane": "General",
          "x-ui-order": 50,
          "x-ui-control": "custom",
          "x-ui-section": "DxUI"
        },
        "windowBackdrop": {
          "$ref": "#/$defs/windowBackdropMode",
          "description": "Choose the DWM system backdrop policy for supported top-level app windows.",
          "x-ui-pane": "General",
          "x-ui-order": 60,
          "x-ui-control": "custom",
          "x-ui-section": "DxUI"
        }
      },
      "additionalProperties": false
    },
    "windowBounds": {
      "type": "object",
      "title": "Window Bounds",
      "description": "Window bounds in device-independent pixels.",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "title": "X",
          "description": "Left position."
        },
        "y": {
          "type": "integer",
          "title": "Y",
          "description": "Top position."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "title": "Width",
          "description": "Window width."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "title": "Height",
          "description": "Window height."
        }
      },
      "additionalProperties": false
    },
    "themeId": {
      "type": "string",
      "pattern": "^(builtin/(system|light|dark|rainbow|highContrast)|user/[A-Za-z0-9][A-Za-z0-9_.-]{0,63})$",
      "title": "Theme Id",
      "description": "Builtin theme id (builtin/*) or user theme id (user/*)."
    },
    "themeDefinition": {
      "type": "object",
      "title": "Theme Definition",
      "description": "A version 2 user-defined theme with authored palette entries and semantic color sources.",
      "required": [
        "formatVersion",
        "id",
        "name",
        "baseThemeId",
        "colors"
      ],
      "properties": {
        "formatVersion": {
          "const": 2,
          "title": "Theme Format Version",
          "description": "Required version of the expressive theme format."
        },
        "id": {
          "type": "string",
          "pattern": "^user/[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Id",
          "description": "Unique theme id (must start with user/)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "title": "Name",
          "description": "Display name for the theme."
        },
        "baseThemeId": {
          "$ref": "#/$defs/builtinThemeId",
          "title": "Base Theme",
          "description": "Builtin theme used as a base for this theme."
        },
        "palette": {
          "type": "object",
          "default": {},
          "maxProperties": 128,
          "title": "Palette",
          "description": "Reusable authored color sources. Palette names are case-sensitive and cannot contain a dot.",
          "patternProperties": {
            "^[A-Za-z0-9_-]{1,64}$": {
              "$ref": "#/$defs/themeColorSource"
            }
          },
          "additionalProperties": false
        },
        "colors": {
          "type": "object",
          "default": {},
          "maxProperties": 512,
          "title": "Color Overrides",
          "description": "Map of semantic color keys to direct colors or version 2 expressions.",
          "properties": {
            "app.accent": {
              "$ref": "#/$defs/themeColorSource"
            },
            "window.background": {
              "$ref": "#/$defs/themeColorSource"
            },
            "menu.background": {
              "$ref": "#/$defs/themeColorSource"
            },
            "menu.text": {
              "$ref": "#/$defs/themeColorSource"
            },
            "menu.disabledText": {
              "$ref": "#/$defs/themeColorSource"
            },
            "menu.selectionBg": {
              "$ref": "#/$defs/themeColorSource"
            },
            "menu.selectionText": {
              "$ref": "#/$defs/themeColorSource"
            },
            "menu.separator": {
              "$ref": "#/$defs/themeColorSource"
            },
            "menu.border": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.background": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.backgroundHover": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.backgroundPressed": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.text": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.separator": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.accent": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.progressOk": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.progressWarn": {
              "$ref": "#/$defs/themeColorSource"
            },
            "navigation.progressBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.background": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.itemBackgroundNormal": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.itemBackgroundHovered": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.itemBackgroundSelected": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.itemBackgroundSelectedInactive": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.itemBackgroundFocused": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.textNormal": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.textSelected": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.textSelectedInactive": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.textDisabled": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.focusBorder": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.gridLines": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.errorBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.errorText": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.warningBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.warningText": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.infoBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "folderView.infoText": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.bg": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.fg": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.caret": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.selection": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.searchHighlight": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.gutterBg": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.gutterFg": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.metaText": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.metaError": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.metaWarning": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.metaInfo": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.metaPerf": {
              "$ref": "#/$defs/themeColorSource"
            },
            "monitor.textView.metaDebug": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.progressBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.progressTotal": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.progressItem": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.progressVerify": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.graphBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.graphGrid": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.graphLimit": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.graphLine": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.graphVerify": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.scrollbarTrack": {
              "$ref": "#/$defs/themeColorSource"
            },
            "fileOps.scrollbarThumb": {
              "$ref": "#/$defs/themeColorSource"
            },
            "viewer.diff.addedBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "viewer.diff.removedBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "viewer.diff.contextBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "viewer.diff.headerBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "viewer.diff.bannerBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "viewer.diff.placeholderBackground": {
              "$ref": "#/$defs/themeColorSource"
            },
            "viewer.diff.divider": {
              "$ref": "#/$defs/themeColorSource"
            }
          },
          "patternProperties": {
            "^[A-Za-z0-9_.-]{1,64}$": {
              "$ref": "#/$defs/themeColorSource"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "monitorMenuState": {
      "type": "object",
      "title": "Monitor Menu",
      "description": "UI state for the Monitor window.",
      "properties": {
        "toolbarVisible": {
          "type": "boolean",
          "default": true,
          "title": "Toolbar",
          "description": "Show or hide the Monitor toolbar."
        },
        "lineNumbersVisible": {
          "type": "boolean",
          "default": true,
          "title": "Line Numbers",
          "description": "Show or hide line numbers in the Monitor."
        },
        "alwaysOnTop": {
          "type": "boolean",
          "default": false,
          "title": "Always On Top",
          "description": "Keep the Monitor window above other windows."
        },
        "showIds": {
          "type": "boolean",
          "default": true,
          "title": "Show Ids",
          "description": "Show numeric ids for messages (useful for debugging)."
        },
        "autoScroll": {
          "type": "boolean",
          "default": true,
          "title": "Auto Scroll",
          "description": "Scroll automatically as new messages arrive."
        }
      },
      "additionalProperties": false
    },
    "monitorFilterSettings": {
      "type": "object",
      "title": "Monitor Filter",
      "description": "Filter applied to Monitor messages.",
      "properties": {
        "mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63,
          "default": 63,
          "title": "Mask",
          "description": "Bitmask of enabled message types (0..63)."
        },
        "preset": {
          "$ref": "#/$defs/monitorFilterPreset",
          "title": "Preset",
          "description": "Named preset filter."
        }
      },
      "additionalProperties": false
    },
    "reducedMotionMode": {
      "type": "string",
      "title": "Reduced Motion",
      "default": "system",
      "enum": [
        "system",
        "on",
        "off"
      ]
    },
    "windowBackdropMode": {
      "type": "string",
      "title": "Window Backdrop",
      "default": "default",
      "enum": [
        "default",
        "none",
        "mica",
        "micaAlt",
        "acrylic"
      ]
    },
    "builtinThemeId": {
      "type": "string",
      "enum": [
        "builtin/system",
        "builtin/light",
        "builtin/dark",
        "builtin/rainbow",
        "builtin/highContrast"
      ],
      "title": "Builtin Theme Id",
      "description": "Identifier of a builtin theme."
    },
    "themeColorSource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "title": "Theme Color Source",
      "description": "A direct hex color or a version 2 theme expression.",
      "anyOf": [
        {
          "$ref": "#/$defs/colorHex"
        },
        {
          "pattern": "^(ref|lighten|darken|alpha|blend|contrast|perceptualTone|ensureContrast|harmonize|systemColor|tone|seededRainbow|seededChoice)\\(.*\\)$"
        },
        {
          "enum": [
            "systemAccent()"
          ]
        }
      ]
    },
    "monitorFilterPreset": {
      "type": "string",
      "title": "Monitor Filter Preset",
      "description": "Named preset describing which message types are shown.",
      "enum": [
        "custom",
        "errorsOnly",
        "errorsWarnings",
        "allTypes"
      ],
      "default": "custom"
    },
    "colorHex": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
      "title": "Color",
      "description": "Hex color string (#RRGGBB or #AARRGGBB)."
    }
  }
}
