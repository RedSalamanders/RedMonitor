<Project>
  <PropertyGroup>
    <RedMonitorRoot>$(MSBuildThisFileDirectory)</RedMonitorRoot>
    <RequiredMsvcToolsVersion>14.52</RequiredMsvcToolsVersion>
    <RedMonitorBuildNumber Condition="'$(RedMonitorBuildNumber)'==''">0</RedMonitorBuildNumber>
    <RedMonitorOutputRoot Condition="'$(RedMonitorOutputRoot)'==''">$(RedMonitorRoot).build\</RedMonitorOutputRoot>
    <OutDir>$(RedMonitorOutputRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RedMonitorOutputRoot)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <VcpkgEnabled>false</VcpkgEnabled>
    <PreferredToolArchitecture Condition="'$(PreferredToolArchitecture)'=='' and '$(PROCESSOR_ARCHITECTURE)'=='ARM64'">arm64</PreferredToolArchitecture>
    <PreferredToolArchitecture Condition="'$(PreferredToolArchitecture)'==''">x64</PreferredToolArchitecture>
    <PlatformToolset>v145</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <RedMonitorTriplet Condition="'$(Platform)'=='x64'">x64-windows-static-md</RedMonitorTriplet>
    <RedMonitorTriplet Condition="'$(Platform)'=='ARM64'">arm64-windows-static-md</RedMonitorTriplet>
    <RedMonitorPackages>$(RedMonitorRoot).build\vcpkg_installed\$(Platform)\$(RedMonitorTriplet)\</RedMonitorPackages>
    <LinkIncremental>false</LinkIncremental>
    <!-- The pinned DxUi Debug library uses /ZI; its final link must support Edit and Continue. -->
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <RedMonitorViewerTestsEnabled Condition="'$(RedMonitorViewerTestsEnabled)'=='' and '$(Configuration)'!='Release'">true</RedMonitorViewerTestsEnabled>
    <RedMonitorViewerTestsEnabled Condition="'$(RedMonitorViewerTestsEnabled)'==''">false</RedMonitorViewerTestsEnabled>
    <CopyAsanBinariesToOutDir Condition="'$(Configuration)'=='ASan Debug'">true</CopyAsanBinariesToOutDir>
    <EnableASAN Condition="'$(Configuration)'=='ASan Debug'">true</EnableASAN>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /FS %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;COMMON_API=;WINVER=0x0A00;_WIN32_WINNT=0x0A00;NTDDI_VERSION=NTDDI_WIN11_GE;RS_DIAGNOSTICS_RUNTIME_OPT_IN;VERSINFO_BUILDNUMBER=$(RedMonitorBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RedMonitorRoot)support;$(RedMonitorRoot)include;$(RedMonitorRoot)Tests;$(RedMonitorRoot)Tests\Support;$(RedMonitorPackages)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExternalIncludePath>$(RedMonitorPackages)include;$(ExternalIncludePath)</ExternalIncludePath>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'!='Release'">MultiThreadedDebugDLL</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <Optimization Condition="'$(Configuration)'!='Release'">Disabled</Optimization>
      <BasicRuntimeChecks Condition="'$(Configuration)'=='ASan Debug'">Default</BasicRuntimeChecks>
      <ForcedIncludeFiles Condition="'$(Configuration)'=='ASan Debug'">$(RedMonitorRoot)support\RequireAddressSanitizer.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'!='Release'">_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(RedMonitorRoot)support;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>UNICODE;_UNICODE;VERSINFO_BUILDNUMBER=$(RedMonitorBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>advapi32.lib;bcrypt.lib;comctl32.lib;dwmapi.lib;ole32.lib;oleaut32.lib;pathcch.lib;shell32.lib;shlwapi.lib;user32.lib;gdi32.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories Condition="'$(Configuration)'=='Release'">$(RedMonitorPackages)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(Configuration)'!='Release'">$(RedMonitorPackages)debug\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
