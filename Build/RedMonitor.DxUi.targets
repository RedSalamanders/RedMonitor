<Project>
  <Import Project="$(DxUiRoot)\Build\DxUi.Consumer.targets" Condition="'$(RedMonitorDxUiSdkRoot)'=='' and '$(DxUiRoot)'!=''" />
  <ItemGroup Condition="'$(RedMonitorDxUiSdkRoot)'=='' and '$(DxUiRoot)'!=''">
    <ProjectReference Update="$(DxUiResolvedRoot)src\DxUi.vcxproj">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);PreferredToolArchitecture=$(PreferredToolArchitecture)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
