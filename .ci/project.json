{
  "schemaVersion": 1,
  "policyVersion": "1",
  "repository": "RedSalamanders/RedMonitor",
  "engine": {
    "repository": "RedSalamanders/.github",
    "ref": "f965c7945aff98dbab352623a0cfbe333e7f282f"
  },
  "kind": "application",
  "adapter": "Tools/Invoke-ProjectCi.ps1",
  "include": [
    "Tests/Fixtures/**"
  ],
  "exclude": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "Specs/**/*.md",
    "Tests/README.md",
    ".github/skills/**/*.md",
    "Specs/Plans/**",
    "Specs/TestRuns/**",
    "Specs/Mockups/**",
    "Measurements/**",
    "docs/**",
    "Changes/**",
    "legacy/**",
    ".agents/**",
    ".claude/**",
    ".vscode/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/dependabot.yml",
    ".github/CODEOWNERS",
    ".codex/**",
    ".github/agents/**",
    ".github/copilot-instructions.md"
  ],
  "formatRoots": [
    "include",
    "src",
    "support",
    "Tests"
  ],
  "formatExclude": [],
  "versionBase": "0.1",
  "winget": {
    "identifier": "RedSalamanders.RedMonitor",
    "executable": "RedMonitor.exe",
    "alias": "redmonitor",
    "license": "MIT",
    "minimumOSVersion": "10.0.22000.2600",
    "smokeTests": [
      {
        "command": "redmonitor",
        "arguments": [
          "--runtime-contract"
        ],
        "timeoutSeconds": 120
      }
    ]
  }
}