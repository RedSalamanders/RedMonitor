#include <windows.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSINFO_FILEVERSION_VALUES
 PRODUCTVERSION VERSINFO_PRODUCTVERSION_VALUES
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if defined(_DEBUG) && defined(ENABLE_TESTS)
 FILEFLAGS VS_FF_DEBUG | VS_FF_SPECIALBUILD
#elif defined(ENABLE_TESTS)
 FILEFLAGS VS_FF_SPECIALBUILD
#elif defined(_DEBUG)
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RedSalamander\0"
            VALUE "FileDescription", "RedMonitor diagnostics viewer\0"
            VALUE "FileVersion", VERSINFO_PACKAGE_VERSION
            VALUE "ProductName", "RedMonitor\0"
            VALUE "ProductVersion", VERSINFO_PACKAGE_VERSION
            VALUE "OriginalFilename", "RedMonitor.exe\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 RedSalamander Authors\0"
#ifdef ENABLE_TESTS
            VALUE "SpecialBuild", "RedSalamander.TestSurface=ENABLE_TESTS\0"
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
